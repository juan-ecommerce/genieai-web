# Server-only credentials. Copy this file to .env and fill it locally.
# Never put this key in a VITE_ variable or in client-side code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Resend email: sender must use a domain verified in your Resend account.
RESENDKEY=
RESEND_FROM=

# Authenticated SMTP: 587 uses STARTTLS; 465 uses immediate TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GenieAI <hello@your-verified-domain.com>

SITE_URL=https://genieai.se
PORT=3000
# Set only when deployed behind that many trusted reverse-proxy hops.
TRUST_PROXY=0

# Amplify build configuration (non-secret). The Compute role reads this secret
# at runtime; credentials are never copied into the deployment bundle.
GENIEAI_SECRET_ID=
GENIEAI_SECRET_REGION=eu-north-1
